---
// Profile page for a PhD or Postdoc alumnus. Driven by the per-file
// records in content/people/alumni/<slug>.yml (uniform 14-field
// schema, see content/people/alumni/_schema.yaml). Every section
// below is hidden when its data is empty, so sparse profiles look
// clean rather than full of empty headers.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PersonPhoto from "../../../components/PersonPhoto.astro";
import { getCollection } from "astro:content";
import { buildPrimaryAuthorSet, isPrimaryAuthor } from "../../../lib/authorship.ts";
import { loadDedupedPersonalPubs } from "../../../lib/personal-pubs.ts";
import { url } from "../../../lib/url.ts";

export const getStaticPaths = (async () => {
  const alumni = await getCollection("alumni");
  return alumni
    .filter((a) => a.data.has_profile)
    .map((a) => ({
      params: { slug: a.data.slug },
      props: { alum: a },
    }));
}) satisfies GetStaticPaths;

const { alum } = Astro.props;
const d = alum.data;

// Header role label: "PhD alum '22 · MediaTek" — folds role, the
// last-year of years_with_group (derived as year_graduated), and the
// destination. Each piece is skipped when blank.
const yearTag = d.year_graduated ? `'${String(d.year_graduated).slice(-2)}` : "";
const roleParts = [`${d.role || "Alum"} alum`, yearTag].filter(Boolean);
const roleLabel = roleParts.join(" ") + (d.destination ? ` · ${d.destination}` : "");

// Group publications: same author-matcher used elsewhere, fed by the
// per-alumnus name_variants list so initialed forms ("X. Yi"), full
// forms ("Xiang Yi"), etc. all hit. Empty list → section omitted.
const publications = await getCollection("publications");
const personSet = buildPrimaryAuthorSet(d.name_variants.length > 0 ? d.name_variants : [d.name]);
const groupPubs = [...publications]
  .filter((p) => p.data.authors.some((a) => isPrimaryAuthor(a, personSet)))
  .sort((a, b) => b.data.sort_key - a.data.sort_key);

// "Other publications" — content/people/<slug>.bib OR
// content/people/alumni/<slug>.bib, deduped against the group bib.
// Reuses the same helper the current-member profiles use; the lookup
// is by slug, so dropping a file at either location wires up.
const groupPubsForDedup = publications.map((p) => p.data);
const personalPubs = loadDedupedPersonalPubs(d.slug, groupPubsForDedup);

const hasResearchSection = Boolean(d.thesis_title || d.research_summary);
// Section title: "PhD Dissertation" for PhD alumni; "Research" for
// Postdocs (no MIT dissertation to point at). The DSpace link only
// renders when dissertation_url is set, which is PhD-only by nature.
const researchSectionTitle = d.role === "PhD" ? "PhD Dissertation" : "Research";
---

<BaseLayout title={d.name} description={`${d.name} — ${roleLabel}, Terahertz Integrated Electronics Group.`}>
  <section class="container profile">
    <p class="profile__back mono"><a href={url("/people/")}>← People</a></p>

    <div class="profile__head">
      <div class="profile__photo">
        <PersonPhoto name={d.name} slug={d.slug} size="large" />
      </div>
      <div class="profile__head-body">
        <h1 class="profile__name">{d.name}</h1>
        <p class="profile__role mono">{roleLabel}</p>
        {d.years_with_group && (
          <p class="profile__meta mono">With the group: {d.years_with_group}</p>
        )}
        {d.co_advisor && (
          <p class="profile__meta mono">Co-advised by {d.co_advisor}</p>
        )}
      </div>
    </div>

    {d.education_before_mit.length > 0 && (
      <section class="profile__section">
        <h2 class="profile__h2">Education before MIT</h2>
        <ul class="profile__list">
          {d.education_before_mit.map((e) => <li>{e}</li>)}
        </ul>
      </section>
    )}

    {d.destination && (
      <section class="profile__section">
        <h2 class="profile__h2">After the group</h2>
        <p class="profile__body">{d.destination}</p>
      </section>
    )}

    {hasResearchSection && (
      <section class="profile__section">
        <h2 class="profile__h2">{researchSectionTitle}</h2>
        {d.thesis_title && (
          <p class="profile__body">
            <strong>Thesis:</strong>{" "}
            {d.dissertation_url ? (
              <a
                class="profile__dspace-link"
                href={d.dissertation_url}
                target="_blank"
                rel="noopener noreferrer"
              >{d.thesis_title}</a>
            ) : (
              d.thesis_title
            )}
            {d.dissertation_url && (
              <>
                {" "}
                <a
                  class="profile__dspace-tag mono"
                  href={d.dissertation_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Read on MIT DSpace"
                >MIT DSpace ↗</a>
              </>
            )}
          </p>
        )}
        {d.research_summary && (
          <p class="profile__body">{d.research_summary}</p>
        )}
      </section>
    )}

    {d.awards && d.awards.length > 0 && (
      <section class="profile__section">
        <h2 class="profile__h2">Awards</h2>
        <ul class="profile__awards">
          {d.awards.map((aw) => <li>{aw}</li>)}
        </ul>
      </section>
    )}

    {groupPubs.length > 0 && (
      <section class="profile__section">
        <h2 class="profile__h2">
          <span>Publications in the group</span>
          <span class="profile__h2-count mono">{groupPubs.length}</span>
        </h2>
        <ul class="profile__pubs">
          {groupPubs.map((p) => {
            const pd = p.data;
            const monthLabel = pd.month
              ? new Date(pd.year, pd.month - 1, 1).toLocaleString("en-US", { month: "short" })
              : "";
            const dateLabel = monthLabel ? `${monthLabel} ${pd.year}` : String(pd.year);
            return (
              <li class="profile-pub">
                <p class="profile-pub__meta mono">
                  {pd.venue && <span class="profile-pub__venue">{pd.venue}</span>}
                  <span class="profile-pub__date">{dateLabel}</span>
                </p>
                <h3 class="profile-pub__title">
                  <a href={url(`/publications/#${pd.key}`)}>{pd.title}</a>
                </h3>
                <p class="profile-pub__authors">{pd.authors_display}</p>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {personalPubs.length > 0 && (
      <section class="profile__section">
        <h2 class="profile__h2">
          <span>Other publications</span>
          <span class="profile__h2-count mono">{personalPubs.length}</span>
        </h2>
        <p class="profile__personal-sub mono">
          Co-authored before joining the group, or independent collaborations
          not involving the Han group.
        </p>
        <ul class="profile__pubs">
          {personalPubs.map((pd) => {
            const monthLabel = pd.month
              ? new Date(pd.year, pd.month - 1, 1).toLocaleString("en-US", { month: "short" })
              : "";
            const dateLabel = monthLabel ? `${monthLabel} ${pd.year}` : String(pd.year);
            return (
              <li class="profile-pub">
                <p class="profile-pub__meta mono">
                  {pd.venue && <span class="profile-pub__venue">{pd.venue}</span>}
                  <span class="profile-pub__date">{dateLabel}</span>
                </p>
                <h3 class="profile-pub__title">{pd.title}</h3>
                <p class="profile-pub__authors">{pd.authors_display}</p>
                {pd.note && <p class="profile-pub__note"><em>{pd.note}</em></p>}
                <details class="profile-pub__bibtex">
                  <summary class="mono">BibTeX</summary>
                  <pre class="mono">{pd.raw_bib}</pre>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {d.notes && (
      <section class="profile__section">
        <h2 class="profile__h2">Notes</h2>
        <p class="profile__body">{d.notes}</p>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .profile {
    padding-block: var(--space-6) var(--space-10);
  }

  .profile__back {
    font-size: var(--text-xs);
    margin-bottom: var(--space-5);
  }

  .profile__back a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .profile__back a:hover {
    color: var(--color-accent);
  }

  .profile__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 0.5px solid var(--color-border);
  }

  @media (min-width: 720px) {
    .profile__head {
      grid-template-columns: 180px 1fr;
      gap: var(--space-6);
      align-items: start;
    }
  }

  .profile__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  @media (min-width: 720px) {
    .profile__name {
      font-size: var(--text-2xl);
    }
  }

  .profile__role {
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    margin-bottom: var(--space-2);
  }

  .profile__meta {
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    margin-bottom: 2px;
  }

  .profile__section {
    margin-bottom: var(--space-8);
  }

  .profile__h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 0.5px solid var(--color-border);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .profile__h2-count {
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    font-weight: var(--weight-regular);
  }

  .profile__body {
    color: var(--color-fg-muted);
    line-height: 1.7;
  }

  /* DSpace dissertation link styling: matches the muted-with-hairline
     pattern used in the PI bio and elsewhere. */
  .profile__dspace-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 0.5px solid var(--color-border);
    padding-bottom: 1px;
  }
  .profile__dspace-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .profile__dspace-tag {
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    text-decoration: none;
    margin-left: var(--space-1);
  }
  .profile__dspace-tag:hover {
    color: var(--color-accent);
  }

  .profile__list {
    list-style: disc;
    padding-left: var(--space-5);
    color: var(--color-fg-muted);
    line-height: 1.6;
  }

  .profile__list li {
    margin-bottom: var(--space-1);
  }

  .profile__awards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .profile__awards li {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
  }

  .profile__pubs {
    list-style: none;
  }

  .profile-pub {
    padding-block: var(--space-4);
    border-bottom: 0.5px solid var(--color-border);
  }

  .profile-pub:first-child {
    padding-top: 0;
  }

  .profile-pub__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
  }

  .profile-pub__venue {
    background: var(--color-accent-tint);
    color: var(--color-accent);
    padding: 1px 6px;
  }

  .profile-pub__date {
    color: var(--color-fg-faint);
    padding: 1px 6px;
  }

  .profile-pub__title {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .profile-pub__title a {
    color: var(--color-fg);
    text-decoration: none;
  }

  .profile-pub__title a:hover {
    color: var(--color-accent);
  }

  .profile-pub__authors {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .profile-pub__note {
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    margin-top: var(--space-2);
  }

  .profile-pub__bibtex {
    margin-top: var(--space-2);
  }

  .profile-pub__bibtex summary {
    cursor: pointer;
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    user-select: none;
  }

  .profile-pub__bibtex summary:hover {
    color: var(--color-accent);
  }

  .profile-pub__bibtex pre {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    background: var(--color-gray-tint);
    padding: var(--space-3);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .profile__personal-sub {
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }
</style>
