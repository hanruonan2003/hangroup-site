---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { url } from "../lib/url.ts";

const publications = await getCollection("publications");
const siteEntry = await getEntry("site", "site");
if (!siteEntry) throw new Error("site.yml not loaded");

const scholarUrl = siteEntry.data.pi.scholar;

// Sort newest-first.
const sorted = [...publications].sort(
  (a, b) => b.data.sort_key - a.data.sort_key,
);

// Group by year.
const byYear = new Map<number, typeof sorted>();
for (const p of sorted) {
  const y = p.data.year;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const pubsConfig = siteEntry.data.publications;

// Year chips render in two tiers (see content/site/site.yml):
//   1. Recent row = years in [currentYear - (year_window - 1), currentYear]
//      that have at least one paper, sorted desc.
//   2. "Older ▾" disclosure = all years with papers before the window,
//      sorted desc. Years with zero papers are NOT rendered (no empty
//      chips for gap years like 2014).
// An older chip stays visible in the main row when its filter is active,
// so the user can see what they've selected without re-expanding.
const yearWindow: number = pubsConfig.year_window;
const currentYear = new Date().getFullYear();
const windowStart = currentYear - (yearWindow - 1);
const recentYears = years.filter((y) => y >= windowStart && y <= currentYear);
const olderYears = years.filter((y) => y < windowStart);
// DOM order: recent first (desc), then older (desc). CSS hides the older
// chips by default; the "Older" toggle reveals them, and an .is-active
// older chip is exempted from hiding via a CSS rule.
const yearChips = [...recentYears, ...olderYears];

// Venue chips render in two tiers (see content/site/site.yml):
//   1. Top row = featured_venues (always shown, in YAML order)
//                  ∪ venues with ≥ threshold papers (auto, by count desc)
//   2. "More venues ▾" disclosure = everything else, alphabetical
// Featured venues with zero papers in the current bib still appear as
// credential-signaling chips — clicking one just yields an empty result.
const featuredVenues: string[] = pubsConfig.featured_venues;
const threshold: number = pubsConfig.featured_venues_threshold;

const venueCounts = new Map<string, number>();
for (const p of sorted) {
  const v = p.data.venue;
  if (!v) continue;
  venueCounts.set(v, (venueCounts.get(v) ?? 0) + 1);
}

const featuredSet = new Set(featuredVenues);
const autoTopVenues = [...venueCounts.entries()]
  .filter(([v, c]) => c >= threshold && !featuredSet.has(v))
  .sort((a, b) => b[1] - a[1])
  .map(([v]) => v);
const topVenues = [...featuredVenues, ...autoTopVenues];
const topVenueSet = new Set(topVenues);

const moreVenues = [...venueCounts.keys()]
  .filter((v) => !topVenueSet.has(v))
  .sort();

const allTopics = [
  ...new Set(sorted.flatMap((p) => p.data.keywords)),
].sort();

const totalCount = sorted.length;

// Helper for the search index attribute — title + author display names, lowercased.
const searchText = (pub: (typeof sorted)[number]): string =>
  `${pub.data.title} ${pub.data.authors_display}`.toLowerCase();

// Format a topic keyword for display: "imaging-radar" → "imaging radar".
const formatTopic = (k: string): string => k.replace(/-/g, " ");
---

<BaseLayout
  title="Publications"
  description={`Selected publications from ${siteEntry.data.site.name}. ${totalCount} entries.`}
>
  <section class="container pubs">
    <header class="pubs__header">
      <div class="pubs__title-row">
        <h1 class="pubs__h1">Publications</h1>
        <div class="pubs__actions mono">
          <a class="pubs__action" href={url("/publications.bib")} download>
            .bib <span aria-hidden="true">↓</span>
          </a>
          {scholarUrl && (
            <a
              class="pubs__action"
              href={scholarUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Google Scholar
            </a>
          )}
        </div>
      </div>

      <details class="pubs__filters" data-filters>
        <summary class="pubs__filters-toggle mono">
          <span>Filters</span>
          <span aria-hidden="true" class="pubs__filters-caret">▾</span>
        </summary>

        <div class="pubs__toolbar" role="group" aria-label="Filter publications">
        <div class="pubs__search-row">
          <input
            class="pubs__search"
            type="search"
            data-search
            placeholder="Search title or author…"
            aria-label="Search publications"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="pubs__status mono">
            <span data-total-count>{totalCount}</span> papers
            <span aria-hidden="true" class="pubs__status-sep">·</span>
            <button type="button" class="pubs__clear" data-clear>Clear filters</button>
          </p>
        </div>

        <div
          class="pubs__chip-group"
          role="group"
          aria-label="Year"
          data-year-group
        >
          {yearChips.map((y) => {
            const tier = y >= windowStart ? "recent" : "older";
            return (
              <button
                type="button"
                class="chip mono"
                data-chip={`year:${y}`}
                data-tier={tier}
                aria-pressed="false"
              >
                {y}
              </button>
            );
          })}
          {olderYears.length > 0 && (
            <button
              type="button"
              class="pubs__more-toggle mono"
              data-older-toggle
              aria-expanded="false"
            >
              Older <span aria-hidden="true" class="pubs__more-caret">▾</span>
            </button>
          )}
        </div>

        <div class="pubs__chip-group" role="group" aria-label="Venue">
          {topVenues.map((v) => (
            <button
              type="button"
              class="chip mono"
              data-chip={`venue:${v}`}
              aria-pressed="false"
            >
              {v}
            </button>
          ))}
          {moreVenues.length > 0 && (
            <button
              type="button"
              class="pubs__more-toggle mono"
              data-more-toggle
              aria-expanded="false"
              aria-controls="pubs-more-venues"
            >
              More venues <span aria-hidden="true" class="pubs__more-caret">▾</span>
            </button>
          )}
        </div>

        <div class="pubs__chip-group" role="group" aria-label="Topic">
          {allTopics.map((t) => (
            <button
              type="button"
              class="chip mono"
              data-chip={`topic:${t}`}
              aria-pressed="false"
            >
              {formatTopic(t)}
            </button>
          ))}
        </div>

        {moreVenues.length > 0 && (
          <div
            class="pubs__chip-group pubs__chip-group--more"
            id="pubs-more-venues"
            role="group"
            aria-label="More venues"
            data-more-venues
            hidden
          >
            {moreVenues.map((v) => (
              <button
                type="button"
                class="chip mono"
                data-chip={`venue:${v}`}
                aria-pressed="false"
              >
                {v}
              </button>
            ))}
          </div>
        )}
      </div>
      </details>
    </header>

    <div class="pubs__empty mono" data-empty-state hidden>
      No publications match the current filters.
    </div>

    <div class="pubs__list">
      {years.map((year) => {
        const entries = byYear.get(year)!;
        return (
          <section class="year-section" data-year-section={String(year)}>
            <h2 class="year-section__h2">
              <span class="year-section__num mono">{year}</span>
              <span class="year-section__count mono">
                <span data-year-count>{entries.length}</span> paper{entries.length === 1 ? "" : "s"}
              </span>
            </h2>
            <ul class="year-section__list">
              {entries.map((pub) => {
                const d = pub.data;
                const venueLabel = d.venue || d.container || "";
                const monthLabel = d.month
                  ? new Date(d.year, d.month - 1, 1).toLocaleString("en-US", {
                      month: "short",
                    })
                  : "";
                const dateLabel = monthLabel ? `${monthLabel} ${d.year}` : String(d.year);
                const showContainer = d.container && d.container !== d.venue;
                const visibleAuthors = d.authors.filter(
                  (a) => !(a.literal && a.family === "others"),
                );
                const authorsLine = visibleAuthors.map((a) => a.raw).join(", ");
                return (
                  <li
                    class="entry"
                    id={d.key}
                    data-pub-entry
                    data-pub-key={d.key}
                    data-pub-year={String(d.year)}
                    data-pub-venue={d.venue}
                    data-pub-topics={d.keywords.join(" ")}
                    data-pub-text={searchText(pub)}
                  >
                    <p class="entry__meta mono">
                      {venueLabel && (
                        <span class="entry__meta-item entry__meta-item--venue">{venueLabel}</span>
                      )}
                      <span class="entry__meta-item">{dateLabel}</span>
                      {d.keywords.map((k) => (
                        <span class="entry__meta-item entry__meta-item--topic">{formatTopic(k)}</span>
                      ))}
                      {d.highlight && (
                        <span class="entry__meta-item entry__meta-item--highlight">Highlight</span>
                      )}
                    </p>
                    <h3 class="entry__title">{d.title}</h3>
                    <div class="entry__byline">
                      <span class="entry__authors">{authorsLine}</span>
                      {showContainer && (
                        <>
                          <span class="entry__byline-sep" aria-hidden="true">—</span>
                          <span class="entry__container">
                            {d.container}
                          </span>
                        </>
                      )}
                      {d.note && (
                        <span class="entry__note">
                          <span aria-hidden="true">— </span><em>{d.note}</em>
                        </span>
                      )}
                      <span class="entry__inline-links mono">
                        {d.pdf && (
                          <a href={d.pdf} class="entry__link">PDF</a>
                        )}
                        {d.video && (
                          <a href={d.video} class="entry__link" target="_blank" rel="noopener noreferrer">Video</a>
                        )}
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script>
  const $ = <T extends Element = Element>(sel: string, root: ParentNode = document): T | null =>
    root.querySelector<T>(sel);
  const $$ = <T extends Element = Element>(sel: string, root: ParentNode = document): T[] =>
    Array.from(root.querySelectorAll<T>(sel));

  type EntryRef = {
    el: HTMLElement;
    year: string;
    venue: string;
    topics: string[];
    text: string;
  };
  type YearSection = { el: HTMLElement; year: string };

  const state = {
    search: "",
    years: new Set<string>(),
    venues: new Set<string>(),
    topics: new Set<string>(),
  };

  const entries: EntryRef[] = $$("[data-pub-entry]").map((el) => {
    const html = el as HTMLElement;
    return {
      el: html,
      year: html.dataset.pubYear ?? "",
      venue: html.dataset.pubVenue ?? "",
      topics: (html.dataset.pubTopics ?? "").split(" ").filter(Boolean),
      text: html.dataset.pubText ?? "",
    };
  });

  const yearSections: YearSection[] = $$("[data-year-section]").map((el) => ({
    el: el as HTMLElement,
    year: (el as HTMLElement).dataset.yearSection ?? "",
  }));

  const totalEl = $<HTMLElement>("[data-total-count]");
  const emptyEl = $<HTMLElement>("[data-empty-state]");
  const searchEl = $<HTMLInputElement>("[data-search]");
  const clearEl = $<HTMLButtonElement>("[data-clear]");

  function matches(e: EntryRef): boolean {
    if (state.search && !e.text.includes(state.search)) return false;
    if (state.years.size && !state.years.has(e.year)) return false;
    if (state.venues.size && !state.venues.has(e.venue)) return false;
    if (state.topics.size && !e.topics.some((t) => state.topics.has(t))) return false;
    return true;
  }

  function applyFilters(): void {
    let total = 0;
    for (const e of entries) {
      const visible = matches(e);
      e.el.hidden = !visible;
      if (visible) total++;
    }
    for (const sec of yearSections) {
      let visibleInYear = 0;
      for (const e of entries) {
        if (e.year === sec.year && !e.el.hidden) visibleInYear++;
      }
      sec.el.hidden = visibleInYear === 0;
      const yc = sec.el.querySelector<HTMLElement>("[data-year-count]");
      if (yc) yc.textContent = String(visibleInYear);
    }
    if (emptyEl) emptyEl.hidden = total > 0;
    if (totalEl) totalEl.textContent = String(total);
  }

  searchEl?.addEventListener("input", () => {
    state.search = (searchEl.value ?? "").toLowerCase();
    applyFilters();
  });

  $$<HTMLButtonElement>("[data-chip]").forEach((chip) => {
    chip.addEventListener("click", () => {
      const raw = chip.dataset.chip ?? "";
      const idx = raw.indexOf(":");
      if (idx === -1) return;
      const group = raw.slice(0, idx);
      const value = raw.slice(idx + 1);
      const set =
        group === "year" ? state.years :
        group === "venue" ? state.venues :
        group === "topic" ? state.topics :
        null;
      if (!set) return;
      if (set.has(value)) {
        set.delete(value);
        chip.classList.remove("is-active");
        chip.setAttribute("aria-pressed", "false");
      } else {
        set.add(value);
        chip.classList.add("is-active");
        chip.setAttribute("aria-pressed", "true");
      }
      applyFilters();
    });
  });

  // "More venues ▾" toggle — reveals the alphabetical fallback row.
  const moreToggle = $<HTMLButtonElement>("[data-more-toggle]");
  const moreVenuesRow = $<HTMLElement>("[data-more-venues]");
  function setMoreVenuesOpen(open: boolean): void {
    if (!moreToggle || !moreVenuesRow) return;
    moreVenuesRow.hidden = !open;
    moreToggle.setAttribute("aria-expanded", String(open));
    moreToggle.classList.toggle("is-open", open);
  }
  moreToggle?.addEventListener("click", () => {
    setMoreVenuesOpen(moreVenuesRow?.hidden ?? false);
  });

  // "Older ▾" toggle — reveals the older year chips inline. Active older
  // chips remain visible even when the disclosure is collapsed (the
  // .is-active CSS rule exempts them from the hide).
  const olderToggle = $<HTMLButtonElement>("[data-older-toggle]");
  const yearGroup = $<HTMLElement>("[data-year-group]");
  function setOlderYearsOpen(open: boolean): void {
    if (!olderToggle || !yearGroup) return;
    yearGroup.classList.toggle("is-expanded", open);
    olderToggle.setAttribute("aria-expanded", String(open));
    olderToggle.classList.toggle("is-open", open);
  }
  olderToggle?.addEventListener("click", () => {
    const isOpen = yearGroup?.classList.contains("is-expanded") ?? false;
    setOlderYearsOpen(!isOpen);
  });

  clearEl?.addEventListener("click", () => {
    state.search = "";
    state.years.clear();
    state.venues.clear();
    state.topics.clear();
    if (searchEl) searchEl.value = "";
    $$<HTMLButtonElement>("[data-chip].is-active").forEach((c) => {
      c.classList.remove("is-active");
      c.setAttribute("aria-pressed", "false");
    });
    applyFilters();
  });

  // Deep-linking: ?topic=imaging-radar,communication&venue=ISSCC&year=2022
  // The research page links here with these params to land on a pre-filtered view.
  function applyParam(group: "year" | "venue" | "topic", set: Set<string>, raw: string): void {
    for (const v of raw.split(",").map((s) => s.trim()).filter(Boolean)) {
      set.add(v);
      const chip = document.querySelector<HTMLButtonElement>(
        `[data-chip="${group}:${v}"]`,
      );
      if (chip) {
        chip.classList.add("is-active");
        chip.setAttribute("aria-pressed", "true");
      }
    }
  }
  const params = new URLSearchParams(window.location.search);
  applyParam("topic", state.topics, params.get("topic") ?? "");
  applyParam("venue", state.venues, params.get("venue") ?? "");
  applyParam("year", state.years, params.get("year") ?? "");
  if (state.topics.size || state.venues.size || state.years.size) {
    applyFilters();
  }
  // If a deep-link selected a venue that lives in the "more" row, expand it
  // so the activated chip is visible.
  if (moreVenuesRow) {
    const hasActiveMore = $$<HTMLButtonElement>(
      "[data-more-venues] [data-chip].is-active",
    ).length > 0;
    if (hasActiveMore) setMoreVenuesOpen(true);
  }

  // Filters are collapsed by default so mobile readers see papers sooner.
  // On desktop (>= 720px) we force-open the panel and hide the toggle via CSS,
  // so desktop behaves exactly as before. The matchMedia listener keeps things
  // sane if the viewport is resized (or the user rotates a tablet).
  const filtersDetails = document.querySelector<HTMLDetailsElement>("[data-filters]");
  if (filtersDetails) {
    const desktop = window.matchMedia("(min-width: 720px)");
    const syncFiltersToViewport = (): void => {
      if (desktop.matches) filtersDetails.open = true;
    };
    syncFiltersToViewport();
    // If a deep-link param activated any chips, surface them on mobile too.
    if (state.topics.size || state.venues.size || state.years.size) {
      filtersDetails.open = true;
    }
    desktop.addEventListener("change", syncFiltersToViewport);
  }
</script>

<style>
  .pubs {
    padding-block: var(--space-6) var(--space-10);
  }

  /* Header */

  .pubs__header {
    margin-bottom: var(--space-6);
  }

  .pubs__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .pubs__h1 {
    font-size: var(--text-xl);
  }

  @media (min-width: 720px) {
    .pubs__h1 {
      font-size: var(--text-2xl);
    }
  }

  .pubs__actions {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
  }

  .pubs__action {
    color: var(--color-fg);
    text-decoration: none;
    border-bottom: 0.5px solid var(--color-border);
    padding-bottom: 1px;
  }

  .pubs__action:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Filters wrapper — collapsed by default on mobile so the paper list
     appears sooner. JS opens it on desktop (>= 720px) and on deep-links;
     the toggle is hidden on desktop via the media query below. */

  .pubs__filters {
    /* No border around the details element itself. */
  }

  .pubs__filters-toggle {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 0;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    border-bottom: 0.5px solid var(--color-border);
    width: 100%;
  }

  .pubs__filters-toggle::-webkit-details-marker {
    display: none;
  }

  .pubs__filters-caret {
    display: inline-block;
    transition: transform 0.15s ease;
    color: var(--color-fg-faint);
  }

  .pubs__filters[open] .pubs__filters-caret {
    transform: rotate(180deg);
  }

  @media (min-width: 720px) {
    .pubs__filters-toggle {
      display: none;
    }
  }

  /* Toolbar — one stacked row per filter group (search+status, years,
     venues, topics). Each row's internal layout wraps independently. */

  .pubs__toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-block: 0.5px solid var(--color-border);
  }

  /* Row 1: search box on the left, status (paper count · clear) on the
     right. Wraps at narrow widths — the search goes full-width and the
     status drops below, left-aligned. */
  .pubs__search-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .pubs__search {
    width: 240px;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-fg);
    background: transparent;
    border: 0;
    border-bottom: 0.5px solid var(--color-border);
    padding: 4px 0;
    min-height: 32px;
  }

  @media (max-width: 700px) {
    .pubs__search {
      width: 100%;
    }
  }

  .pubs__search:focus {
    outline: 0;
    border-bottom-color: var(--color-accent);
  }

  .pubs__chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg);
    background: transparent;
    border: 0.5px solid var(--color-border);
    padding: 0 8px;
    cursor: pointer;
    line-height: 1.4;
    min-height: 24px;
  }

  /* Touch targets a bit larger on coarse pointers. */
  @media (pointer: coarse) {
    .chip {
      min-height: 32px;
      padding: 4px 10px;
    }
  }

  .chip:hover {
    border-color: var(--color-fg);
  }

  .chip.is-active {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  /* Older year chips: hidden by default, revealed when the parent group
     is marked .is-expanded by the "Older ▾" toggle. Active chips are
     exempt so a selected older year stays visible even after collapsing
     the disclosure (matches the persistence rule called out in the
     filter spec). */
  .chip[data-tier="older"] {
    display: none;
  }

  [data-year-group].is-expanded .chip[data-tier="older"],
  .chip[data-tier="older"].is-active {
    display: inline-block;
  }

  /* "More venues ▾" — a subtle text toggle at the end of the venue row;
     deliberately not chip-shaped so it reads as an action, not a filter. */
  .pubs__more-toggle {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    background: transparent;
    border: 0;
    padding: 0 4px;
    margin-left: var(--space-1);
    cursor: pointer;
    line-height: 1.4;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .pubs__more-toggle:hover {
    color: var(--color-accent);
  }

  .pubs__more-caret {
    display: inline-block;
    transition: transform 0.15s ease;
    color: var(--color-fg-faint);
  }

  .pubs__more-toggle.is-open .pubs__more-caret {
    transform: rotate(180deg);
  }

  /* Secondary row of less-frequent venues; sits at the bottom of the
     toolbar so the alphabetical chips get their own dedicated band
     rather than crowding the top venue row. */
  .pubs__chip-group--more {
    padding-top: var(--space-2);
    border-top: 0.5px dashed var(--color-border);
  }

  /* Status line — paper count + clear, compact. Sits inline with the
     search input on row 1 (margin-left:auto pushes it to the right
     edge; on wrap it lands on its own line, left-aligned, because
     justify-content:space-between on the parent leaves a sole flex
     item at the start of its row). */

  .pubs__status {
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin: 0;
  }

  .pubs__status-sep {
    color: var(--color-fg-faint);
  }

  .pubs__clear {
    font-family: inherit;
    font-size: inherit;
    color: var(--color-fg-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

