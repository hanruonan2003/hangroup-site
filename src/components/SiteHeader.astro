---
import { getEntry } from "astro:content";
import { url } from "../lib/url.ts";

const siteEntry = await getEntry("site", "site");
if (!siteEntry) throw new Error("site.yml not loaded");
const siteName = siteEntry.data.site.name;

// The logo (red square + site title in the header) links home, so a
// dedicated "Home" tab is redundant. On the home page no nav item gets
// the active underline — that's intentional.
type NavItem = { href: string; label: string };
const navItems: NavItem[] = [
  { href: "/research/", label: "Research" },
  { href: "/people/", label: "People" },
  { href: "/publications/", label: "Publications" },
  { href: "/news/", label: "News" },
  { href: "/contact/", label: "Contact" },
];

// Strip the configured base from the request path before comparing nav items,
// which are authored as "/people/" etc. (without base).
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, "");
const currentPath = (Astro.url.pathname.replace(BASE, "") || "/");
const isActive = (href: string): boolean => {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath === href || currentPath.startsWith(href);
};
---

<header class="site-header" transition:persist="site-header">
  <div class="container site-header__inner">
    <a
      class="site-mark"
      href={url("/")}
      aria-label={`${siteName} home`}
      data-nav-target="home"
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      <span class="site-mark__square" aria-hidden="true"></span>
      <span class="site-mark__name">{siteName}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={url(item.href)}
              data-nav-target={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <span class="site-header__underline" data-underline aria-hidden="true"></span>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.5px solid var(--color-border);
    padding-block: var(--space-4);
    /* The .site-header__inner is position: relative so the underline
       (absolutely positioned) is measured against the inner content
       box, matching what the active-target getBoundingClientRect calls
       see. */

    /* Stick to the top of the viewport while scrolling. The opaque dark
       background prevents page content from showing through; z-index sits
       above content (publications filters, hero images, etc.). */
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);

    /* Mobile gets a slide-up animation when JS adds .is-hidden on
       scroll-down; desktop keeps transform untouched (no-op). The
       shadow appears once .is-scrolled is set (scroll > 4px) so the
       pinned header reads as separated from the content beneath. */
    transition: transform 200ms ease, box-shadow 160ms ease;
    will-change: transform;
  }

  .site-header.is-scrolled {
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 767px) {
    .site-header.is-hidden {
      transform: translateY(-100%);
    }
  }

  /* Sliding active-tab underline. Positioned absolutely inside the
     header's inner box; JS sets translate + width on each navigation
     so it animates from old → new active target. Lives across pages
     via transition:persist on the header. */
  .site-header__underline {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    transition: transform 220ms ease-out, width 220ms ease-out;
  }

  /* No transition before the first measurement places it under the
     initial active target — prevents an animation from (0,0). */
  .site-header__underline[data-initial] {
    transition: none;
  }

  /* Mobile (default): two-row header. Row 1 = logo (red square + full
     site title, links home), row 2 = all 5 tabs distributed across the
     row. Stretch the children so the nav can use the full width.
     position: relative anchors the absolutely positioned underline. */
  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
    position: relative;
  }

  /* Desktop: single row, logo on the left, tabs on the right. */
  @media (min-width: 768px) {
    .site-header__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-6);
    }
  }

  /* Logo is the only path home now that the Home tab is gone, so give
     it a clear hover affordance on desktop (subtle brightening). On
     mobile the row is generously tappable. */
  .site-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-fg);
    align-self: flex-start;
    transition: opacity 0.15s ease;
  }

  .site-mark:hover {
    color: var(--color-fg);
    opacity: 0.85;
  }

  .site-mark__square {
    display: inline-block;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .site-mark__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Nav stretches across the mobile row; min-width:0 lets the inner
     ul shrink and flex-wrap actually wrap on very narrow viewports. */
  .site-nav {
    align-self: stretch;
    min-width: 0;
    border-top: 0.5px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  @media (min-width: 768px) {
    .site-nav {
      border-top: 0;
      padding-top: 0;
    }

    .site-nav ul {
      justify-content: flex-end;
      gap: var(--space-4) var(--space-5);
    }
  }

  .site-nav a {
    display: inline-block;
    text-decoration: none;
    color: var(--color-fg);
    /* Tighter font on mobile so all 5 tabs fit on one line at 375px;
       desktop keeps text-sm via the media override below. */
    font-size: 13px;
    /* ~40px tap target on mobile (10px top + 10px bottom + line-box). */
    padding-block: 10px;
    border-bottom: 2px solid transparent;
  }

  /* Sub-breakpoint for very narrow phones (≤ 379px): shrink to 12px
     and tighten the ul gap so all 5 tabs still fit on one line at
     320px instead of wrapping "Contact" to a third row. */
  @media (max-width: 379px) {
    .site-nav ul {
      gap: var(--space-1);
    }
    .site-nav a {
      font-size: 12px;
    }
  }

  @media (min-width: 768px) {
    .site-nav a {
      font-size: var(--text-sm);
      padding-block: 2px;
    }
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  /* Active-page indicator is now the sliding .site-header__underline
     element; per-tab border-bottom is left transparent so the slider
     owns the visual without doubling up. */
</style>

<script>
  // Sliding active-tab underline. The header is persisted across
  // client-side navigations (transition:persist="site-header"), so the
  // underline DOM survives. On each astro:page-load we recompute the
  // active target and animate the underline to it. Initial paint
  // positions without animation via the [data-initial] attribute.
  //
  // Active target rules:
  //   - On "/", target the .site-mark (logo + title).
  //   - On any tab path, target the matching <a data-nav-target="...">.
  //
  // The init guard prevents listener accumulation if this script ever
  // re-executes during a swap (which can happen if Astro detects the
  // module needs to re-run).
  if (!(window as any).__siteHeaderUnderlineInit) {
    (window as any).__siteHeaderUnderlineInit = true;

    const findActive = (): HTMLElement | null => {
      const header = document.querySelector<HTMLElement>(".site-header");
      if (!header) return null;
      const path = window.location.pathname.replace(/\/+$/, "") + "/";
      // Strip the configured base from the request path before matching.
      const base = ((import.meta as any).env?.BASE_URL ?? "/").replace(
        /\/+$/,
        "",
      );
      const stripped = path.startsWith(base) ? path.slice(base.length) : path;
      const requestPath = stripped || "/";
      // Tab match first (longest-prefix wins so /people/ruonan-han/ → /people/).
      const tabs = Array.from(
        header.querySelectorAll<HTMLAnchorElement>("[data-nav-target]"),
      ).filter((t) => t.dataset.navTarget !== "home");
      const sortedByLen = [...tabs].sort(
        (a, b) =>
          (b.dataset.navTarget?.length ?? 0) -
          (a.dataset.navTarget?.length ?? 0),
      );
      for (const t of sortedByLen) {
        const href = t.dataset.navTarget ?? "";
        if (requestPath === href || requestPath.startsWith(href)) return t;
      }
      // No tab matched → underline lives under the logo on home.
      return header.querySelector<HTMLElement>('[data-nav-target="home"]');
    };

    const sync = (animate: boolean): void => {
      const header = document.querySelector<HTMLElement>(".site-header");
      const inner = header?.querySelector<HTMLElement>(".site-header__inner");
      const underline = header?.querySelector<HTMLElement>("[data-underline]");
      if (!header || !inner || !underline) return;

      const active = findActive();
      // Update aria-current to reflect the new page since the persisted
      // header is not re-rendered by the server.
      header
        .querySelectorAll<HTMLElement>("[data-nav-target]")
        .forEach((el) => el.removeAttribute("aria-current"));
      if (active) active.setAttribute("aria-current", "page");
      if (!active) {
        underline.style.width = "0";
        return;
      }

      if (!animate) underline.setAttribute("data-initial", "");

      const innerRect = inner.getBoundingClientRect();
      const r = active.getBoundingClientRect();
      const x = r.left - innerRect.left;
      const y = r.bottom - innerRect.top - 2; // 2 = underline height
      underline.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      underline.style.width = `${r.width}px`;

      if (!animate) {
        // Force a reflow so the no-transition position applies, then
        // remove the marker so subsequent updates animate.
        void underline.offsetWidth;
        requestAnimationFrame(() => underline.removeAttribute("data-initial"));
      }
    };

    let firstRun = true;
    const syncOnNavigation = (): void => {
      sync(!firstRun);
      firstRun = false;
    };

    document.addEventListener("astro:page-load", syncOnNavigation);

    // Reposition on resize without animation (snap), debounced via RAF.
    let resizeFrame = 0;
    window.addEventListener("resize", () => {
      if (resizeFrame) cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => sync(false));
    });
  }

  // Sticky/hide-on-scroll behavior. Same one-time-init pattern as the
  // underline above — the header is persisted across client-side
  // navigations (transition:persist="site-header"), so the scroll
  // listener attached to window also survives. We just reset internal
  // state on astro:page-load so a fresh page that arrives at scrollY=0
  // doesn't inherit a stale .is-hidden class from the previous page.
  if (!(window as any).__siteHeaderScrollInit) {
    (window as any).__siteHeaderScrollInit = true;

    // Threshold below which scroll jitter doesn't toggle visibility.
    const HIDE_THRESHOLD_PX = 10;
    // scrollY > this adds .is-scrolled (drop shadow). Kept small so the
    // shadow appears almost immediately on first scroll.
    const SHADOW_THRESHOLD_PX = 4;
    const mobileMQ = window.matchMedia("(max-width: 767px)");

    let lastScroll = Math.max(0, window.scrollY);
    let frame = 0;

    const update = (): void => {
      frame = 0;
      const header = document.querySelector<HTMLElement>(".site-header");
      if (!header) return;
      const y = Math.max(0, window.scrollY);

      header.classList.toggle("is-scrolled", y > SHADOW_THRESHOLD_PX);

      if (mobileMQ.matches) {
        const dy = y - lastScroll;
        const headerH = header.getBoundingClientRect().height || 96;
        if (Math.abs(dy) > HIDE_THRESHOLD_PX) {
          if (dy > 0 && y > headerH) {
            // Scrolling down, past the header's own height — hide it.
            header.classList.add("is-hidden");
          } else if (dy < 0) {
            // Any upward scroll reveals immediately.
            header.classList.remove("is-hidden");
          }
          lastScroll = y;
        }
        // Always visible at the very top of the page.
        if (y <= 0) header.classList.remove("is-hidden");
      } else {
        // Desktop stays pinned regardless.
        header.classList.remove("is-hidden");
        lastScroll = y;
      }
    };

    const onScroll = (): void => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    // Reset on each Astro navigation: the persisted header could carry
    // an .is-hidden class from the previous page even though the new
    // page lands at scrollY=0.
    document.addEventListener("astro:page-load", () => {
      lastScroll = Math.max(0, window.scrollY);
      update();
    });

    // Initial sync (covers the very first page paint).
    update();
  }
</script>
